{
  "expo": {
    "name": "Ders Notlarım",
    "slug": "ders-notlari-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bclblr.dersnotlarim"
    },
    "android": {
      "package": "com.bclblr.dersnotlarim"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Ders Notlarım, dersleri kaydetmek için mikrofon erişimi ister.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {}
  }
}