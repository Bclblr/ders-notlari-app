{
  "expo": {
    "name": "BBC",
    "slug": "ders-notlari-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bclblr.dersnotlarim"
    },
    "android": {
      "package": "com.bclblr.dersnotlarim",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#6339B8"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "BBC, dersleri kaydetmek için mikrofon erişimi ister.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {}
  }
}